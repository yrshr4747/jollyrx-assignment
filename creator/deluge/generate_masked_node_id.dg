// Plant_Vault > Workflow > On Success (create only).
// Region_Code is private helper data and is never sent to Commerce.
// Global count yields the demo sequence BD-01, GJ-02, HP-03. This fits the
// isolated demo; production should use an atomic counter to avoid races.
region = ifnull(input.Region_Code, "").trim().toUpperCase();
if(!region.matches("^[A-Z]{2}$"))
{
	info "Invalid region code; Masked_Node_ID was not generated.";
}
else
{
	prior = Plant_Vault[ID != input.ID].count();
	sequence = prior + 1;
	sequenceText = sequence.toString();
	if(sequence < 10)
	{
		sequenceText = "0" + sequenceText;
	}
	input.Masked_Node_ID = "NODE-" + region + "-" + sequenceText;
}
