// Creator Custom API: POST, Public Key auth, JSON {"payload":"<JSON string>"}.
// This app function is void; Creator's Standard API response is used.
void RFQ_Intake(string payload)
{
	try
	{
		req = payload.toMap();
		buyer = ifnull(req.get("Buyer_Name"),"").trim();
		email = ifnull(req.get("Email"),"").trim();
		node = ifnull(req.get("Node_ID"),"").trim();
		qty = ifnull(req.get("Target_Quantity"),0).toLong();
		// Honeypot: silently accept bots without creating an inquiry.
		if(ifnull(req.get("website"),"") != "")
		{
			return;
		}
		if(buyer == "" || buyer.length() > 120 || email == "" || !email.contains("@") || !email.contains(".") || qty <= 0 || qty > 100000000 || !node.matches("^NODE-[A-Z]{2}-[0-9]{2}$"))
		{
			throw "Invalid RFQ fields";
		}
		plant = Plant_Vault[Masked_Node_ID == node];
		if(plant.count() != 1)
		{
			throw "Unknown Node ID";
		}
		insert into RFQ_Inquiries
		[
			Node_ID = node
			Buyer_Name = buyer
			Email = email
			Target_Quantity = qty
			Status = "New"
		];
	}
	catch(e)
	{
		info e;
		throw "Unable to submit this RFQ";
	}
}
