// Custom API POST, Entire JSON argument `payload`, Public Key auth.
try
{
 req = payload.toMap();
 buyer = ifnull(req.get("Buyer_Name"),"").trim(); email = ifnull(req.get("Email"),"").trim();
 node = ifnull(req.get("Node_ID"),"").trim(); qty = ifnull(req.get("Target_Quantity"),0).toLong();
 if(ifnull(req.get("website"),"") != "") { return {"ok":true,"message":"RFQ received"}; }
 if(buyer == "" || buyer.length() > 120 || !email.matches("^[^@\s]+@[^@\s]+\.[^@\s]+$") || qty <= 0 || qty > 100000000 || !node.matches("^NODE-[A-Z]{2}-[0-9]{2}$"))
 { return {"ok":false,"message":"Please check the RFQ fields."}; }
 plant = Plant_Vault[Masked_Node_ID == node];
 if(plant.count() != 1) { return {"ok":false,"message":"Please check the RFQ fields."}; }
 insert into RFQ_Inquiries [Node_ID=plant.ID Buyer_Name=buyer Email=email Target_Quantity=qty Submitted_At=zoho.currenttime Status="New"];
 return {"ok":true,"message":"RFQ received"};
}
catch(e) { info e; return {"ok":false,"message":"Unable to submit right now."}; }
