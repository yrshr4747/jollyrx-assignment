// Plant_Vault on success; connection jollyrx_commerce_masked_catalog_sync;
// configure India DC base URL/org ID.
// Required Commerce API fields (name/url/variants) are included. Only masked
// catalog data and the Node ID SKU enter the product payload. Rate is zero for
// quote-only items; hide price/cart in the storefront and verify before publish.
try
{
 p = Map();
 node = input.Masked_Node_ID;
 title = input.Dosage_Form + " - " + node;
 p.put("name", title);
 p.put("url", node.toLowerCase());
 p.put("product_short_description", "Anonymized Node ID: " + node + " | Dosage Form: " + input.Dosage_Form + " | Certification: " + input.Certification + " | MOQ: " + input.MOQ);
 p.put("product_description", "Anonymized Node ID: " + node + "\nDosage Form: " + input.Dosage_Form + "\nCertification: " + input.Certification + "\nMOQ: " + input.MOQ);
 p.put("show_in_storefront", true);
 v = Map();
 v.put("rate", "0");
 v.put("sku", node);
 v.put("status", "active");
 variants = List(); variants.add(v);
 p.put("variants", variants);
 h = Map(); h.put("X-com-zoho-store-organizationid","{{COMMERCE_ORG_ID}}");
 h.put("Content-Type","application/json");
 if(input.Commerce_Product_ID == null || input.Commerce_Product_ID == "")
 {
  resp = invokeurl [url:"{{COMMERCE_BASE_URL}}/store/api/v1/products" type:POST body:p.toString() headers:h connection:"jollyrx_commerce_masked_catalog_sync"];
 }
 else
 {
  resp = invokeurl [url:"{{COMMERCE_BASE_URL}}/store/api/v1/products/" + input.Commerce_Product_ID type:PUT body:p.toString() headers:h connection:"jollyrx_commerce_masked_catalog_sync"];
 }
 // Map ID only after confirming current tenant's response JSON shape.
 if(resp.get("code") == 0 && resp.get("product") != null)
 { input.Commerce_Product_ID = resp.get("product").get("product_id"); input.Sync_Status = "Synced"; }
 else { input.Sync_Status = "Failed: inspect workflow log"; info resp; }
}
catch(e) { input.Sync_Status = "Failed: inspect workflow log"; info e; }
